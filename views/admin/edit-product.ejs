<%- include('../partials/head') %>
<body>
  <%- include('../partials/nav') %>
    <main>
      <h1 class="mt-5 text-4xl text-center">Edit the Product</h1>
      <div class="m-4 flex justify-center items-center">
        <form class="w-1/3 p-6 bg-gray-100 rounded-xl flex flex-col" action="/admin/edit-product/<%= product._id %>" method="POST">
          <input class="p-2 m-1 text-2xl border-2 border-gray-300 rounded-lg" name="id" type="hidden" value="<%= product._id %>">
          <label class="text-2xl mt-2" for="productName">Name: </label>
          <input class="p-2 m-1 text-2xl border-2 border-gray-300 rounded-lg" type="text" name="productName" placeholder="Product Name" value="<%= product.productName %>" required />
          <label class="text-2xl mt-2" for="price">Price: </label>
          <input class="p-2 m-1 text-2xl border-2 border-gray-300 rounded-lg" type="text" name="price" id="price" placeholder="Price" value="<%= product.price %>" required>
          <label class="text-2xl mt-2" for="rating">Rating: </label>
          <input class="p-2 m-1 text-2xl border-2 border-gray-300 rounded-lg" type="text" name="rating" id="rating" placeholder="Enter the Rating" value="<%= product.Rating %>" required>
          <label class="text-2xl mt-2" for="imageUrl">URL: </label>
          <input class="p-2 m-1 text-2xl border-2 border-gray-300 rounded-lg" type="text" name="imageUrl" id="imageUrl" placeholder="Enter the URL of image" value="<%= product.imageUrl %>" required>
          <label class="text-2xl mt-2" for="description">Description: </label>
          <textarea class="h-40 p-2 m-1 text-2xl border-2 border-gray-300 rounded-lg" name="description" id="description" placeholder="Description"><%= product.description %></textarea>
          <div class="flex justify-center">
            <input class="w-1/2 p-3 mt-6 text-2xl bg-black text-white rounded-lg cursor-pointer" type="submit" value="Update"/>
          </div>
        </form>
      </div>
    </main>
  </body>
</html>
 