<% if (errors.length > 0) { %>
            <div
              class="px-4 py-3 mb-4 bg-[#FFF7F2] border-2 border-[#FB5D01] text-[#E65000] rounded"
              role="alert"
            >
                <strong class="font-bold">Error!</strong>
                <ul class="list-disc list-inside space-y-1">
                    <% errors.forEach(error => { %>
                       <li><%= error %></li> 
                    <% }); %>
                </ul>
            </div>            
<% } %>